# 10. Figure 5: SVM Decision Boundary
X_2d = df[['Age', 'Tumor_Size_mm']].values
y_2d = df['Diagnosis_Encoded'].values

scaler_2d = StandardScaler()
X_2d_scaled = scaler_2d.fit_transform(X_2d)

svm_2d = SVC(kernel='rbf', C=1.0, gamma='scale')
svm_2d.fit(X_2d_scaled, y_2d)

h = 0.02

x_min = X_2d_scaled[:, 0].min() - 1
x_max = X_2d_scaled[:, 0].max() + 1
y_min = X_2d_scaled[:, 1].min() - 1
y_max = X_2d_scaled[:, 1].max() + 1

xx, yy = np.meshgrid(
    np.arange(x_min, x_max, h),
    np.arange(y_min, y_max, h)
)

Z = svm_2d.predict(
    np.c_[xx.ravel(), yy.ravel()]
)

Z = Z.reshape(xx.shape)

plt.figure(figsize=(9, 7))

plt.contourf(
    xx, yy, Z,
    alpha=0.3,
    cmap='RdYlGn'
)

plt.scatter(
    X_2d_scaled[:, 0],
    X_2d_scaled[:, 1],
    c=y_2d,
    cmap='RdYlGn',
    edgecolors='k',
    s=60,
    alpha=0.7
)

plt.xlabel('Age (Standardized)')
plt.ylabel('Tumor Size (Standardized)')
plt.title('SVM Decision Boundary (2D)')

plt.tight_layout()

plt.savefig('figure5_svm_decision_boundary.png',
            dpi=300, bbox_inches='tight')
plt.close()

# 11. Final Results
print("\nFINAL MODEL PERFORMANCE")
